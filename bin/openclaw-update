#!/usr/bin/env node
// openclaw-update — safe OpenClaw update manager.
// Safe-by-default: read-only commands do not mutate; mutating commands require
// an explicit subcommand and, for promote/cleanup, --yes unless --dry-run.

const [major, minor] = process.versions.node.split('.').map(Number);
if (major < 22 || (major === 22 && minor < 19)) {
  process.stderr.write(`openclaw-update requires Node.js 22.19+. Current: ${process.versions.node}\n`);
  process.exit(1);
}

import { spawnSync, spawn } from 'node:child_process';
import readline from 'node:readline';
import { existsSync, mkdirSync, readFileSync, writeFileSync, readdirSync, rmSync, lstatSync, renameSync, cpSync, symlinkSync, mkdtempSync, unlinkSync, createWriteStream, appendFileSync } from 'node:fs';
import { resolve, dirname, basename } from 'node:path';
import { homedir, tmpdir } from 'node:os';
import { fileURLToPath } from 'node:url';
import { runSmoketest, formatTextReport } from '../lib/smoketest.mjs';
import { detectPlatform, getPlistPath, restartGateway as platformRestartGateway } from '../lib/gateway-control.mjs';

const HERE = dirname(fileURLToPath(import.meta.url));
const ROOT = resolve(HERE, '..');
const OPENCLAW_DIR = resolve(homedir(), '.openclaw');
const VERSIONS_DIR = resolve(OPENCLAW_DIR, 'versions');
const CURRENT_LINK = resolve(OPENCLAW_DIR, 'current');
const PREVIOUS_LINK = resolve(OPENCLAW_DIR, 'previous');
const MANIFEST = resolve(OPENCLAW_DIR, 'versions-manifest.json');
const GATEWAY_LABEL = 'ai.openclaw.gateway';
const GATEWAY_PLIST = getPlistPath(GATEWAY_LABEL);
const WORKSPACE_GIT = process.env.OPENCLAW_UPDATE_WORKSPACE_GIT ?? null;
const CLAWD_DIR = resolve(homedir(), 'clawd');
const SNAPSHOT_HELPER = resolve(ROOT, 'lib/state-snapshot.sh');

function usage() {
  console.log(`Usage: openclaw-update <command> [options]

Commands:
  check [--json]                 Compare current version with npm latest
  status [--json]                Show current/previous/staged versions and drift
  stage <version|latest>         npm install --prefix ~/.openclaw/versions/<v> openclaw@<v>
  preflight <version|latest> [--json] [--port N]
                                 Boot the staged version against an APFS clone of your REAL state dir.
                                 Catches startup-migration and plugin peer-link failures sandbox-test cannot see.
  sandbox-test <version|latest> [--config-source <path>]
                                 Boot staged version on an alternate port/config and smoketest it.
                                 --config-source <path>: dry-run a proposed openclaw.json edit before applying to live.
  smoketest [--quick] [--json] [--with-models] [--no-telegram] [--alert-on-fail]
                                 Run live smoketest against current gateway
                                 --alert-on-fail: post to alert-bus DM if any tests fail
  promote <version> --yes [--skip <ids>]
                                 Swap ~/.openclaw/current to a staged version, restart, smoketest; auto-rollback on failure.
                                 --skip 04,11 to skip specific test ids during the post-promote smoketest.
  rollback                       Run the one-command rollback helper
  cleanup --yes [--keep N] [--include-broken]
                                 Remove old staged versions; never deletes current/previous.
                                 --include-broken also removes .broken-<timestamp>/ forensic dirs.
  uninstall --yes [--remove-versions]
                                 Restore system openclaw, remove openclaw-update tools, restart gateway, smoketest.
                                 Default: keep ~/.openclaw/versions/ (printed reminder to delete in 30 days).
                                 --remove-versions: also delete ~/.openclaw/versions/.

Safety:
  migrate-to-versioned.sh performs the one-time switchover. Promote/cleanup/uninstall require --yes.
  This CLI never changes ~/.openclaw state for check/status/smoketest.

Environment overrides:
  OPENCLAW_NODE         Path to node binary (default: process.execPath)
  OPENCLAW_NPM          Path to npm binary (default: sibling of node binary, or which npm)
  OPENCLAW_INSTALL_DIR  Path to openclaw package directory (the dir containing openclaw.mjs)`);
}

function parse(argv) {
  const args = { _: [], json: false, yes: false, dryRun: false, quick: false, keep: 3, telegram: true, withModels: false, interpret: false, port: 18790, bonjourWatchSec: 120, verbose: false, skip: [], configSource: null, skipPreflight: false, alertOnFail: false, includeBroken: false, removeVersions: false };
  for (let i = 2; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--json') args.json = true;
    else if (a === '--yes' || a === '-y') args.yes = true;
    else if (a === '--dry-run') args.dryRun = true;
    else if (a === '--quick') args.quick = true;
    else if (a === '--with-telegram') args.telegram = true; // no-op/backwards compat; Telegram is on by default
    else if (a === '--no-telegram') args.telegram = false;
    else if (a === '--with-models') args.withModels = true;
    else if (a === '--port') args.port = Number(argv[++i]);
    else if (a === '--bonjour-watch-sec') args.bonjourWatchSec = Number(argv[++i]);
    else if (a === '--config-source') args.configSource = argv[++i];
    else if (a === '--skip-preflight') args.skipPreflight = true;
    else if (a === '--skip') args.skip = argv[++i].split(',').map(s => s.trim()).filter(Boolean);
    else if (a === '--verbose') args.verbose = true;
    else if (a === '--interpret') args.interpret = true;
    else if (a === '--alert-on-fail') args.alertOnFail = true;
    else if (a === '--keep') args.keep = Number(argv[++i]);
    else if (a === '--include-broken') args.includeBroken = true;
    else if (a === '--remove-versions') args.removeVersions = true;
    else if (a === '--keep-versions') args.removeVersions = false;
    else if (a === '-h' || a === '--help') { usage(); process.exit(0); }
    else args._.push(a);
  }
  return args;
}

function run(cmd, argv, opts = {}) {
  const r = spawnSync(cmd, argv, { encoding: 'utf8', stdio: opts.stdio ?? 'pipe', timeout: opts.timeout ?? 120000, env: opts.env ?? process.env });
  if (r.error) throw new Error(`${cmd}: ${r.error.message}`);
  return r;
}

// ── Node selection ─────────────────────────────────────────────────────────
// OpenClaw declares an engines.node range and refuses to boot outside it, and its
// entry point re-execs `node` resolved from PATH. Running this script via
// `#!/usr/bin/env node` under an nvm shell therefore picked nvm's node, handed it
// to the gateway child, and the child died on the version check — which looked
// exactly like a hang, because nothing reported the child's exit. Pick a node that
// satisfies the TARGET version's own engines rather than whatever ran us.

function parseVer(s) {
  const m = String(s || '').match(/(\d+)\.(\d+)\.(\d+)/);
  return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
}

function cmpVer(a, b) {
  for (let i = 0; i < 3; i++) if (a[i] !== b[i]) return a[i] < b[i] ? -1 : 1;
  return 0;
}

// Handles the npm engines grammar OpenClaw actually uses: comparator clauses
// joined by spaces (AND), alternatives joined by `||` (OR).
function satisfiesRange(version, range) {
  const v = parseVer(version);
  if (!v || !range) return Boolean(v);
  return range.split('||').some(clause => clause.trim().split(/\s+/).filter(Boolean).every(cmp => {
    const m = cmp.match(/^(>=|<=|>|<|=)?\s*v?(\d+\.\d+\.\d+)/);
    if (!m) return true;
    const c = cmpVer(v, parseVer(m[2]));
    switch (m[1]) {
      case '>=': return c >= 0;
      case '<=': return c <= 0;
      case '>': return c > 0;
      case '<': return c < 0;
      default: return c === 0;
    }
  }));
}

function enginesFor(version) {
  const pkg = version
    ? resolve(VERSIONS_DIR, version, 'node_modules/openclaw/package.json')
    : resolve(CURRENT_LINK, 'node_modules/openclaw/package.json');
  try { return JSON.parse(readFileSync(pkg, 'utf8'))?.engines?.node ?? null; } catch { return null; }
}

function nodeCandidates() {
  const out = [];
  const push = p => { if (p && !out.includes(p) && existsSync(p)) out.push(p); };
  push(process.env.OPENCLAW_NODE);
  push(process.execPath);
  push('/opt/homebrew/bin/node');
  push('/usr/local/bin/node');
  const r = spawnSync('which', ['-a', 'node'], { encoding: 'utf8', timeout: 5000 });
  if (r.status === 0) for (const line of (r.stdout || '').split('\n')) push(line.trim());
  return out;
}

// Highest satisfying candidate wins, so a too-old nvm node never shadows a good one.
function resolveNode(version) {
  const range = enginesFor(version);
  const scored = nodeCandidates().map(p => {
    const q = spawnSync(p, ['-v'], { encoding: 'utf8', timeout: 5000 });
    return { path: p, ver: q.status === 0 ? parseVer(q.stdout) : null };
  }).filter(c => c.ver && satisfiesRange(c.ver.join('.'), range));
  scored.sort((a, b) => cmpVer(b.ver, a.ver));
  return scored[0]?.path ?? (process.env.OPENCLAW_NODE || process.execPath);
}

// Pin the chosen node's dir first so OpenClaw's PATH-based respawn lands on it too.
function pinNodeFor(version) {
  NODE = resolveNode(version);
  process.env.PATH = `${dirname(NODE)}:${process.env.PATH ?? ''}`;
  return NODE;
}

function detectInstall() {
  const node = resolveNode();

  let npm;
  if (process.env.OPENCLAW_NPM) {
    npm = process.env.OPENCLAW_NPM;
  } else {
    const npmSibling = resolve(dirname(node), 'npm');
    if (existsSync(npmSibling)) {
      npm = npmSibling;
    } else {
      const r = spawnSync('which', ['npm'], { encoding: 'utf8', timeout: 5000 });
      npm = r.status === 0 ? r.stdout.trim() : 'npm';
    }
  }

  let installDir = process.env.OPENCLAW_INSTALL_DIR || null;
  if (!installDir) {
    const r = spawnSync(npm, ['root', '-g'], { encoding: 'utf8', timeout: 15000 });
    if (r.status === 0 && r.stdout.trim()) {
      const candidate = resolve(r.stdout.trim(), 'openclaw');
      if (existsSync(resolve(candidate, 'openclaw.mjs'))) installDir = candidate;
    }
  }

  return { NODE: node, NPM: npm, INSTALL_DIR: installDir };
}

let { NODE, NPM, INSTALL_DIR } = detectInstall();
process.env.PATH = `${dirname(NODE)}:${process.env.PATH ?? ''}`;

function versionFromOutput(s) {
  return (s || '').match(/(\d{4}\.\d+\.\d+)/)?.[1] ?? null;
}

function readlink(path) {
  const r = run('readlink', ['-f', path]);
  return r.status === 0 ? r.stdout.trim() : null;
}

function currentVersion() {
  if (existsSync(CURRENT_LINK) && lstatSync(CURRENT_LINK).isSymbolicLink()) {
    const target = readlink(CURRENT_LINK);
    const pkg = target && resolve(target, 'lib/node_modules/openclaw/package.json');
    if (pkg && existsSync(pkg)) return JSON.parse(readFileSync(pkg, 'utf8')).version;
    return target ? basename(target).replace(/\.broken-.*/, '') : null;
  }
  const entry = INSTALL_DIR && resolve(INSTALL_DIR, 'openclaw.mjs');
  if (entry && existsSync(entry)) {
    const r = run(NODE, [entry, '--version'], { timeout: 10000 });
    return versionFromOutput(r.stdout || r.stderr);
  }
  const r = run('openclaw', ['--version'], { timeout: 10000 });
  return versionFromOutput(r.stdout || r.stderr);
}

function latestVersion() {
  const r = run(NPM, ['view', 'openclaw', 'version'], { timeout: 30000 });
  if (r.status !== 0) throw new Error(`npm view failed: ${r.stderr || r.stdout}`);
  return r.stdout.trim();
}

function loadManifest() {
  if (!existsSync(MANIFEST)) return { schema: 1, events: [] };
  try { return JSON.parse(readFileSync(MANIFEST, 'utf8')); }
  catch { return { schema: 1, events: [], _corrupt: true }; }
}

function saveManifest(m) {
  mkdirSync(dirname(MANIFEST), { recursive: true });
  writeFileSync(MANIFEST, JSON.stringify(m, null, 2) + '\n');
}

function addEvent(event) {
  const m = loadManifest();
  m.events ||= [];
  m.events.push({ timestamp: new Date().toISOString(), ...event });
  if (event.current) m.current = event.current;
  if (event.previous) m.previous = event.previous;
  saveManifest(m);
}

// Transcript logger — tees stdout/stderr to a per-run log file so we can
// reconstruct exactly what a promote/rollback/cleanup did, even days later.
const LOG_DIR = resolve(OPENCLAW_DIR, 'logs', 'openclaw-update');
let TRANSCRIPT_PATH = null;
function installTranscript(label) {
  try {
    mkdirSync(LOG_DIR, { recursive: true });
    const ts = new Date().toISOString().replace(/[:.]/g, '-');
    TRANSCRIPT_PATH = resolve(LOG_DIR, `${ts}-${label}.log`);
    const stream = createWriteStream(TRANSCRIPT_PATH, { flags: 'a' });
    stream.write(`# openclaw-update ${label} @ ${new Date().toISOString()}\n`);
    stream.write(`# argv: ${JSON.stringify(process.argv.slice(2))}\n\n`);
    const wrap = (orig) => (chunk, enc, cb) => {
      try { stream.write(chunk, enc); } catch {}
      return orig(chunk, enc, cb);
    };
    const origOut = process.stdout.write.bind(process.stdout);
    const origErr = process.stderr.write.bind(process.stderr);
    process.stdout.write = wrap(origOut);
    process.stderr.write = wrap(origErr);
    process.on('exit', (code) => {
      try { stream.write(`\n# exit ${code} @ ${new Date().toISOString()}\n`); stream.end(); } catch {}
    });
    console.log(`(transcript → ${TRANSCRIPT_PATH})`);
  } catch (err) {
    console.error(`(transcript setup failed, continuing: ${err.message})`);
  }
}

function listVersions() {
  if (!existsSync(VERSIONS_DIR)) return [];
  return readdirSync(VERSIONS_DIR, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => d.name)
    .sort();
}

function versionDir(version) { return resolve(VERSIONS_DIR, version); }
function packageDir(version) {
  const dir = versionDir(version);
  const npmLayout = resolve(dir, 'node_modules/openclaw');
  const legacyLayout = resolve(dir, 'lib/node_modules/openclaw');
  if (existsSync(npmLayout)) return npmLayout;
  return legacyLayout;
}

function installDirForCurrent() {
  if (existsSync(CURRENT_LINK) && lstatSync(CURRENT_LINK).isSymbolicLink()) return resolve(CURRENT_LINK, 'lib/node_modules/openclaw');
  return INSTALL_DIR;
}

function output(obj, args, text) {
  if (args.json) console.log(JSON.stringify(obj, null, 2));
  else console.log(text ?? JSON.stringify(obj, null, 2));
}

function fetchChangelog(version) {
  const cacheDir = resolve(OPENCLAW_DIR, 'cache/changelog');
  mkdirSync(cacheDir, { recursive: true });
  const cachePath = resolve(cacheDir, `openclaw-${version}.md`);
  if (existsSync(cachePath)) return readFileSync(cachePath, 'utf8');
  const url = `https://registry.npmjs.org/openclaw/-/openclaw-${version}.tgz`;
  const r = spawnSync('sh', ['-c', `curl -sfL '${url}' | tar xz -O package/CHANGELOG.md 2>/dev/null`], { encoding: 'utf8', timeout: 60000, maxBuffer: 10 * 1024 * 1024 });
  if (r.status !== 0 || !r.stdout) throw new Error(`fetch failed for openclaw-${version}.tgz`);
  writeFileSync(cachePath, r.stdout);
  return r.stdout;
}

function releasesBetween(current, latest) {
  const r = run(NPM, ['view', 'openclaw', 'time', '--json'], { timeout: 60000 });
  if (r.status !== 0) return [latest];
  let times;
  try { times = JSON.parse(r.stdout); } catch { return [latest]; }
  const tCur = Date.parse(times[current] ?? '');
  const tLat = Date.parse(times[latest] ?? '');
  if (!tCur || !tLat) return [latest];
  const versions = Object.entries(times)
    .filter(([v]) => v !== 'created' && v !== 'modified')
    // Keep `-1`/`-2` correction releases; drop alpha/beta/rc trains, which are
    // superseded by the stable release that follows them.
    .filter(([v]) => !/-(alpha|beta|rc)\./i.test(v))
    .filter(([, t]) => { const ms = Date.parse(t); return ms > tCur && ms <= tLat; })
    .sort((a, b) => Date.parse(a[1]) - Date.parse(b[1]))
    .map(([v]) => v);
  return versions.length ? versions : [latest];
}

// Each release tarball ships only its own notes, so slicing one changelog between
// two version headings yielded a stub whenever the span crossed releases. Walk the
// releases in the span and concatenate.
function changelogDiff(latest, current) {
  const MAX = 40000;
  const chunks = [];
  for (const v of releasesBetween(current, latest)) {
    let cl;
    try { cl = fetchChangelog(v); } catch { continue; }
    const start = cl.indexOf(`## ${v}`);
    if (start === -1) { const t = cl.trim(); if (t) chunks.push(t); continue; }
    // Older tarballs were cumulative — stop at the next release heading if present.
    const next = cl.indexOf('\n## ', start + 1);
    const body = (next === -1 ? cl.slice(start) : cl.slice(start, next)).trim();
    if (body) chunks.push(body);
  }
  if (!chunks.length) return '';
  chunks.reverse(); // newest first, so truncation drops the oldest notes
  return chunks.join('\n\n').slice(0, MAX).trim();
}

function interpretPrompt(current, latest) {
  const userContext = process.env.OPENCLAW_UPDATE_INTERPRET_CONTEXT
    ? `\n\nUser-provided context:\n${process.env.OPENCLAW_UPDATE_INTERPRET_CONTEXT}`
    : '';
  return `An OpenClaw update from ${current} to ${latest} is available. Below is the changelog diff between these releases. Your job: decide whether ANYTHING in here warrants attention, and if so summarize.${userContext}

Output a single JSON object (no markdown, no extra text):
{
  "summary": "item1; item2; item3",   // 3-5 short phrases, semicolon-separated, ≤50 chars each. Empty string if NOTHING is interesting.
  "noteworthy": true|false,            // true ONLY if a TRULY compelling reason to update today (e.g., new major model support, fix for a crash bug, critical security CVE). Polish, incremental plugin work, and unrelated provider integrations are NEVER noteworthy.
  "breaking": true|false,             // true if this update requires manual action BEFORE promoting (e.g., openclaw.json schema migration, removed config field, changed behavior in routing/skills/MCP that would require config adjustment). False for standard updates even when there are behavior changes.
  "breaking_notes": ""                // If breaking: true, one sentence describing exactly what manual step is needed before running openclaw-update promote. Empty string if breaking: false.
}

Be ruthless. The defaults are noteworthy: false, breaking: false. Most updates require no manual intervention. Only set "breaking" to true if you can identify a specific action the user must take before the gateway will restart cleanly on the existing config. Deprecation warnings alone are not breaking — only changes that would cause the gateway to fail or misbehave on startup.`;
}

async function cmdCheck(args) {
  const current = currentVersion();
  const latest = latestVersion();
  const status = current === latest ? 'current' : 'stale';
  const result = { status, current, latest };
  if (args.interpret && status === 'stale') {
    try {
      result.changelog_diff = changelogDiff(latest, current);
      result.interpretation_prompt = interpretPrompt(current, latest);
    } catch (err) {
      result.interpret_error = err.message;
    }
  }
  output(result, args, status === 'current' ? `OpenClaw is current (${current}).` : `OpenClaw update available: ${current} → ${latest}`);
  process.exit(status === 'current' ? 0 : 1);
}

function driftStatus() {
  const migrated = existsSync(CURRENT_LINK) && lstatSync(CURRENT_LINK).isSymbolicLink();
  const brewBin = '/opt/homebrew/bin/openclaw';
  const stubOk = existsSync(brewBin) && readFileSync(brewBin, 'utf8').includes('openclaw is managed by openclaw-update');
  const wrapper = resolve(OPENCLAW_DIR, 'bin/openclaw');
  const which = run('which', ['openclaw'], { timeout: 5000 }).stdout.trim();
  const interactiveWhich = spawnSync('/bin/zsh', ['-ic', 'which openclaw'], { encoding: 'utf8', timeout: 10000 }).stdout?.trim() || '';
  const issues = [];
  if (migrated && !stubOk) issues.push('brew openclaw binary is not the managed stub; possible npm install -g drift');
  if (migrated && !existsSync(wrapper)) issues.push(`managed wrapper missing: ${wrapper}`);
  if (migrated && interactiveWhich && interactiveWhich !== wrapper) issues.push(`interactive zsh resolves openclaw to ${interactiveWhich}, expected ${wrapper}`);
  return { migrated, stubOk, which, interactiveWhich, issues };
}

function cmdStatus(args) {
  const current = currentVersion();
  const currentTarget = existsSync(CURRENT_LINK) ? readlink(CURRENT_LINK) : null;
  const previousTarget = existsSync(PREVIOUS_LINK) ? readlink(PREVIOUS_LINK) : null;
  const versions = listVersions();
  const manifest = loadManifest();
  const drift = driftStatus();
  const obj = { current, currentTarget, previousTarget, versions, manifestCurrent: manifest.current, manifestPrevious: manifest.previous, drift };
  const text = [
    `current:  ${current ?? 'unknown'}${currentTarget ? ` (${currentTarget})` : ''}`,
    `previous: ${previousTarget ? basename(previousTarget) : 'none'}`,
    `versions: ${versions.join(', ') || 'none'}`,
    `drift:    ${drift.issues.length ? drift.issues.join('; ') : 'none'}`,
  ].join('\n');
  output(obj, args, text);
  process.exit(drift.issues.length ? 2 : 0);
}

function resolveRequestedVersion(v) {
  if (!v || v === 'latest') return latestVersion();
  if (v === 'current') return currentVersion();
  return v;
}

function cmdStage(args) {
  const requested = args._[1];
  if (!requested) throw new Error('stage requires <version|latest>');
  const version = resolveRequestedVersion(requested);
  const dir = versionDir(version);
  const pkg = packageDir(version);
  if (existsSync(pkg)) {
    console.log(`Already staged: ${version} at ${dir}`);
    return;
  }
  mkdirSync(dir, { recursive: true });
  console.log(`Staging openclaw@${version} into ${dir} ...`);
  const r = run(NPM, ['install', '--prefix', dir, `openclaw@${version}`], { stdio: 'inherit', timeout: 300000 });
  if (r.status !== 0) throw new Error(`npm install failed with ${r.status}`);
  mkdirSync(resolve(dir, 'bin'), { recursive: true });
  try { writeFileSync(resolve(dir, 'bin/openclaw'), `#!/bin/sh\nexec "${NODE}" "${resolve(packageDir(version), 'openclaw.mjs')}" "$@"\n`); } catch {}
  // Compat: launchd plist + the global wrapper still reference the legacy layout
  // `<version>/lib/node_modules/openclaw/...`. npm install --prefix produces
  // `<version>/node_modules/openclaw/...`. We need a path shim that works for
  // both. NOTE: a self-referencing `lib -> .` symlink causes macOS launchd to
  // fail bootstrap with EIO error 5. The shim must be a real `lib/node_modules/`
  // directory containing a single relative symlink `openclaw -> ../../node_modules/openclaw`.
  try {
    const libNm = resolve(dir, 'lib/node_modules');
    const libNmOpenclaw = resolve(libNm, 'openclaw');
    if (!existsSync(libNmOpenclaw) && existsSync(resolve(dir, 'node_modules/openclaw'))) {
      mkdirSync(libNm, { recursive: true });
      symlinkSync('../../node_modules/openclaw', libNmOpenclaw);
    }
  } catch {}
  addEvent({ event: 'stage', version, path: dir });
  console.log(`Staged ${version}. Next: openclaw-update promote ${version} --yes`);
}


function writeSandboxConfig(sandboxDir, port, configSource) {
  // configSource: path to the openclaw.json to test. Defaults to the live config,
  // but pass a custom path to dry-run a proposed edit before applying to live.
  const src = configSource || resolve(OPENCLAW_DIR, 'openclaw.json');
  if (!existsSync(src)) throw new Error(`missing ${src}`);
  const cfg = JSON.parse(readFileSync(src, 'utf8'));

  // Keep the user's real config shape, but make the sandbox non-invasive:
  // alternate port, loopback bind, no channel polling/webhooks, no Tailscale/Bonjour.
  cfg.gateway ||= {};
  cfg.gateway.port = port;
  cfg.gateway.bind = 'loopback';
  cfg.gateway.auth = { mode: 'none' };
  if (cfg.gateway.tailscale && typeof cfg.gateway.tailscale === 'object') cfg.gateway.tailscale.mode = 'off';
  else cfg.gateway.tailscale = { mode: 'off', resetOnExit: false };
  cfg.discovery ||= {};
  cfg.discovery.mdns ||= {};
  cfg.discovery.mdns.mode = 'off';
  if (cfg.channels && typeof cfg.channels === 'object') {
    for (const provider of Object.keys(cfg.channels)) {
      if (cfg.channels[provider] && typeof cfg.channels[provider] === 'object') {
        cfg.channels[provider].enabled = false;
        cfg.channels[provider].accounts ||= {};
        for (const acct of Object.keys(cfg.channels[provider].accounts)) {
          if (cfg.channels[provider].accounts[acct] && typeof cfg.channels[provider].accounts[acct] === 'object') {
            cfg.channels[provider].accounts[acct].enabled = false;
          }
        }
      }
    }
  }
  const cfgPath = resolve(sandboxDir, 'openclaw.json');
  writeFileSync(cfgPath, JSON.stringify(cfg, null, 2) + '\n');
  return cfgPath;
}

async function runSandboxTestCore(args, version) {
  if (!existsSync(packageDir(version))) cmdStage({ ...args, _: ['stage', version] });
  pinNodeFor(version);
  const installDir = packageDir(version);
  if (!existsSync(resolve(installDir, 'dist/index.js'))) throw new Error(`staged install is missing dist/index.js: ${installDir}`);

  const sandboxDir = mkdtempSync(resolve(tmpdir(), `openclaw-sandbox-${version}-`));
  mkdirSync(resolve(sandboxDir, 'logs'), { recursive: true });
  const cfgPath = writeSandboxConfig(sandboxDir, args.port, args.configSource);
  if (args.configSource) console.log(`Using config source: ${args.configSource}`);
  const out = resolve(sandboxDir, 'gateway.stdout.log');
  const err = resolve(sandboxDir, 'gateway.err.log');
  console.log(`Sandbox config: ${cfgPath}`);
  console.log(`Starting openclaw@${version} on port ${args.port} ...`);

  const child = spawn(NODE, [resolve(installDir, 'dist/index.js'), 'gateway', 'run', '--port', String(args.port), '--allow-unconfigured', '--bind', 'loopback'], {
    env: {
      ...process.env,
      OPENCLAW_HOME: sandboxDir,
      OPENCLAW_CONFIG_PATH: cfgPath,
      OPENCLAW_GATEWAY_PORT: String(args.port),
      OPENCLAW_DISABLE_BONJOUR: '1',
    },
    stdio: ['ignore', 'pipe', 'pipe'],
    detached: true,
  });
  let stderrTail = '';
  child.stdout.on('data', d => writeFileSync(out, d, { flag: 'a' }));
  child.stderr.on('data', d => { stderrTail = (stderrTail + d).slice(-2000); writeFileSync(err, d, { flag: 'a' }); });

  // A gateway that dies at startup used to look like a hang: every remaining test
  // burned its full timeout in silence. Record the exit so we can stop immediately
  // and show why.
  let exitInfo = null;
  child.on('exit', (code, signal) => { exitInfo = { code, signal }; });

  let report;
  try {
    report = await runSmoketest({
      target: 'sandbox',
      mode: args.quick ? 'quick' : 'full',
      installDir,
      configDir: sandboxDir,
      port: args.port,
      telegram: false, // test 09 is current/live only; sandbox must not touch real Telegram polling
      models: args.withModels,
      bonjourWatchSec: args.bonjourWatchSec,
      verbose: args.verbose,
      skip: args.skip,
      onResult: args.json ? null : (r) => console.log(`  ${r.ok ? '✓' : '✗'} ${r.id}-${r.name} (${r.duration_ms}ms)${r.detail ? '  — ' + r.detail : ''}`),
      abortIf: () => exitInfo
        ? `sandbox gateway exited early (code=${exitInfo.code}, signal=${exitInfo.signal})\n--- gateway stderr ---\n${stderrTail.trim() || '(empty)'}`
        : null,
    });
  } finally {
    try { process.kill(-child.pid, 'SIGTERM'); } catch {}
    setTimeout(() => { try { process.kill(-child.pid, 'SIGKILL'); } catch {} }, 3000).unref();
  }
  return { report, sandboxDir };
}

async function cmdSandboxTest(args) {
  const requested = args._[1] || 'latest';
  const version = resolveRequestedVersion(requested);
  const { report, sandboxDir } = await runSandboxTestCore(args, version);
  if (args.json) console.log(JSON.stringify({ version, sandboxDir, report }, null, 2));
  // Per-test lines already streamed via onResult; just add the tally.
  else console.log(`${report.passed} passed, ${report.failed} failed, ${report.skipped} skipped`);
  if (report?.aborted) console.error(`\nAborted: ${report.aborted}`);
  process.exit(report?.failed || report?.aborted ? 1 : 0);
}

async function cmdSmoketest(args) {
  const report = await runSmoketest({
    target: 'current',
    mode: args.quick ? 'quick' : 'full',
    installDir: installDirForCurrent(),
    configDir: OPENCLAW_DIR,
    port: 18789,
    telegram: args.telegram,
    models: args.withModels,
    skip: args.skip,
  });
  if (args.json) console.log(JSON.stringify(report, null, 2));
  else console.log(formatTextReport(report));
  if (args.alertOnFail && report.failed > 0) {
    const failedTests = report.results.filter(r => !r.ok);
    const details = failedTests.map(r => `${r.id}-${r.name}${r.detail ? `: ${r.detail}` : ''}`).join('; ');
    const message = `Smoketest failed: ${report.failed}/${report.passed + report.failed} tests failed. ${details}`;
    await announceToDM(JSON.stringify({ source: 'openclaw-update', kind: 'smoketest-failure', urgency: 'now', message }));
  }
  process.exit(report.failed ? 1 : 0);
}

function snapshotState(versionDirPath) {
  const r = spawnSync('bash', ['-c', `source "${SNAPSHOT_HELPER}" && snapshot_state "${versionDirPath}"`], { encoding: 'utf8', timeout: 30000 });
  if (r.status !== 0) throw new Error(`state snapshot failed: ${(r.stderr || r.stdout || '').trim()}`);
  process.stdout.write(r.stdout);
}

async function notify(text) {
  const cmd = process.env.OPENCLAW_UPDATE_NOTIFY_CMD;
  if (!cmd) {
    process.stderr.write(`[openclaw-update] ${text}\n`);
    return;
  }
  try {
    const payload = JSON.stringify({ source: 'openclaw-update', message: text, timestamp: new Date().toISOString() });
    const r = spawnSync('sh', ['-c', cmd], { input: payload, encoding: 'utf8', timeout: 10000 });
    if (r.status !== 0) process.stderr.write(`[notify] command failed (non-fatal): ${(r.stderr || r.stdout || '').trim().slice(0, 200)}\n`);
  } catch (err) {
    process.stderr.write(`[notify] skipped (non-fatal): ${err.message}\n`);
  }
}

function tagClawdGit(oldVersion, newVersion) {
  if (!WORKSPACE_GIT) return null;
  if (!existsSync(resolve(WORKSPACE_GIT, '.git'))) return null;
  const ts = new Date().toISOString().replace(/[:.]/g, '-');
  const tagName = `openclaw-update-pre-${ts}-from-${oldVersion}-to-${newVersion}`;
  const status = spawnSync('git', ['-C', WORKSPACE_GIT, 'status', '--porcelain'], { encoding: 'utf8', timeout: 10000 });
  const dirty = (status.stdout || '').trim().length > 0;
  if (dirty) {
    console.log(`  ${WORKSPACE_GIT} has uncommitted changes — committing them so the tag is meaningful`);
    spawnSync('git', ['-C', WORKSPACE_GIT, 'add', '-A'], { encoding: 'utf8', timeout: 30000 });
    spawnSync('git', ['-C', WORKSPACE_GIT, 'commit', '-m', `wip: pre-openclaw-update-${newVersion}`], { encoding: 'utf8', timeout: 30000 });
  }
  const tag = spawnSync('git', ['-C', WORKSPACE_GIT, 'tag', tagName], { encoding: 'utf8', timeout: 10000 });
  if (tag.status !== 0) {
    console.log(`  git tag failed (non-fatal): ${(tag.stderr || tag.stdout).trim()}`);
    return null;
  }
  // Best-effort push, do not fail promote on push failure
  const push = spawnSync('git', ['-C', WORKSPACE_GIT, 'push', 'origin', '--tags'], { encoding: 'utf8', timeout: 30000 });
  if (push.status !== 0) console.log(`  workspace tagged locally only (push failed): ${(push.stderr || push.stdout).trim().slice(0, 120)}`);
  else console.log(`  workspace tagged: ${tagName} (pushed)`);
  return tagName;
}

function assertBonjourDisabled() {
  // Bonjour crash-loop is macOS-only; no guard needed on Linux.
  if (detectPlatform() !== 'macos') return;
  let envGuard = false;
  if (existsSync(GATEWAY_PLIST)) {
    const plist = readFileSync(GATEWAY_PLIST, 'utf8');
    const idx = plist.indexOf('OPENCLAW_DISABLE_BONJOUR');
    envGuard = idx !== -1 && /<string>1<\/string>/.test(plist.slice(idx));
  }
  let configGuard = false;
  const cfgPath = resolve(OPENCLAW_DIR, 'openclaw.json');
  if (existsSync(cfgPath)) {
    try {
      const c = JSON.parse(readFileSync(cfgPath, 'utf8'));
      configGuard = c?.discovery?.mdns?.mode === 'off';
    } catch {}
  }
  if (!envGuard && !configGuard) {
    throw new Error(
      'Bonjour is NOT disabled. Refusing to promote — gateway may crash-loop after restart.\n' +
      '  Fix: set discovery.mdns.mode = "off" in ~/.openclaw/openclaw.json,\n' +
      `       OR add OPENCLAW_DISABLE_BONJOUR=1 to ${GATEWAY_PLIST}.`
    );
  }
  console.log(`Bonjour guard: env=${envGuard ? 'on' : 'off'} config=${configGuard ? 'on' : 'off'}`);
}

// Top-level ~/.openclaw entries the migration preflight does not need. Everything
// else is cloned so the staged version meets the same legacy sidecars it will meet
// on the real boot. `cron` is excluded deliberately: it is not a migration source,
// and a cloned gateway that inherits due jobs would fire them for real.
//
// `npm` must NOT be excluded: it holds the installed external plugins. Without it
// the config preflight takes an "install missing plugin" branch and never reaches
// the state-migration gate we are trying to test — a silent false pass.
const PREFLIGHT_SKIP = new Set(['versions', 'media', 'cache', 'browser', 'cron']);
const PREFLIGHT_SKIP_PREFIXES = ['.state-pre-restore-', '.doctor-fix-snapshots'];

// The sandbox test boots on an empty OPENCLAW_HOME, so startup migrations have
// nothing to migrate and failures there are structurally invisible — that is how
// 2026.7.1-2 passed sandbox and then refused to report ready on the real state.
// This boots the staged version against an APFS clone of the live state dir:
// faithful legacy sidecars, zero writes to the real one, and cheap because
// clonefile shares blocks until written.
async function runMigrationPreflight(args, requested) {
  const version = resolveRequestedVersion(requested);
  if (!existsSync(packageDir(version))) cmdStage({ ...args, _: ['stage', version] });
  pinNodeFor(version);
  const installDir = packageDir(version);
  if (!existsSync(resolve(installDir, 'dist/index.js'))) throw new Error(`staged install is missing dist/index.js: ${installDir}`);

  const homeDir = mkdtempSync(resolve(tmpdir(), `openclaw-preflight-${version}-`));
  console.log(`Cloning live state → ${homeDir}`);
  const t0 = Date.now();
  for (const entry of readdirSync(OPENCLAW_DIR)) {
    if (PREFLIGHT_SKIP.has(entry)) continue;
    if (PREFLIGHT_SKIP_PREFIXES.some(p => entry.startsWith(p))) continue;
    // -c requests APFS clonefile: near-instant, no extra disk until written.
    const r = spawnSync('cp', ['-Rc', resolve(OPENCLAW_DIR, entry), resolve(homeDir, entry)], { encoding: 'utf8', timeout: 300000 });
    if (r.status !== 0) console.log(`  clone warning: ${entry} (${(r.stderr || '').trim().split('\n')[0] || `exit ${r.status}`})`);
  }
  mkdirSync(resolve(homeDir, 'logs'), { recursive: true });
  console.log(`Cloned in ${Math.round((Date.now() - t0) / 1000)}s`);

  // Reuse the sandbox hardening: alternate port, no auth, no channels, no
  // Tailscale/mDNS. Written before the repair below so nothing in this rehearsal
  // ever runs against the live bot tokens.
  const cfgPath = writeSandboxConfig(homeDir, args.port, resolve(OPENCLAW_DIR, 'openclaw.json'));
  // OPENCLAW_STATE_DIR is what actually redirects state: the migration resolves
  // legacy sidecars as <stateDir>/plugin-state/state.sqlite. With only
  // OPENCLAW_HOME set, the boot still reads the REAL state dir — both unsafe and
  // a false pass, since it cannot see the clone's sidecars.
  const cloneEnv = { ...process.env, OPENCLAW_HOME: homeDir, OPENCLAW_STATE_DIR: homeDir, OPENCLAW_CONFIG_PATH: cfgPath, OPENCLAW_DISABLE_BONJOUR: '1' };

  // Simulate the post-promote world, not the pre-promote one: point the clone's
  // `current` at the staged version. External plugins pin an absolute peer link
  // to whatever `current` was when they were installed, so this is what exposes
  // peer-link drift.
  run('ln', ['-sfn', versionDir(version), resolve(homeDir, 'current')]);

  // Mirror what promote does after the swap: relink external plugins against the
  // new runtime, or the startup guard rejects them.
  console.log('Running plugin convergence repair against the clone ...');
  const repair = spawnSync(NODE, [resolve(installDir, 'dist/index.js'), 'update', 'repair', '--yes'], { env: cloneEnv, encoding: 'utf8', timeout: 900000 });
  if (repair.status !== 0) console.log(`  repair warning: exit ${repair.status} (continuing; the boot below is the real verdict)`);

  const err = resolve(homeDir, 'gateway.err.log');
  console.log(`Booting openclaw@${version} against cloned state on port ${args.port} ...`);
  const child = spawn(NODE, [resolve(installDir, 'dist/index.js'), 'gateway', 'run', '--port', String(args.port), '--bind', 'loopback'], {
    env: { ...cloneEnv, OPENCLAW_GATEWAY_PORT: String(args.port) },
    stdio: ['ignore', 'pipe', 'pipe'],
    detached: true,
  });
  let stderrAll = '';
  child.stdout.on('data', d => { stderrAll += d; });
  child.stderr.on('data', d => { stderrAll += d; writeFileSync(err, d, { flag: 'a' }); });
  let exitInfo = null;
  child.on('exit', (code, signal) => { exitInfo = { code, signal }; });

  const deadline = Date.now() + 90000;
  let healthy = false;
  while (Date.now() < deadline && !exitInfo) {
    try {
      const res = await fetch(`http://127.0.0.1:${args.port}/healthz`);
      if (res.ok) { healthy = true; break; }
    } catch {}
    await new Promise(r => setTimeout(r, 1000));
  }
  try { process.kill(-child.pid, 'SIGTERM'); } catch {}
  setTimeout(() => { try { process.kill(-child.pid, 'SIGKILL'); } catch {} }, 3000).unref();

  // The migration guard is the failure we are hunting: it exits non-zero rather
  // than serving /healthz, and names the offending sidecars in its reason.
  const migrationGate = /startup migrations did not complete cleanly/i.test(stderrAll);
  const warnings = [...new Set([...stderrAll.matchAll(/^- (Left .+|Plugin ".+)$/gm)].map(m => m[1]))];
  const result = { version, ok: healthy, migrationGate, warnings, homeDir, stderr: stderrAll.trim().slice(-2000) };

  if (healthy) {
    console.log(`✓ migration preflight passed — ${version} completed startup migrations against real state`);
    if (warnings.length) for (const w of warnings) console.log(`  note: ${w}`);
    rmSync(homeDir, { recursive: true, force: true });
  } else {
    console.error(`✗ migration preflight FAILED — ${version} would not boot on your real state`);
    if (migrationGate) console.error('  cause: startup migration guard refused to report the gateway ready');
    for (const w of warnings) console.error(`  - ${w}`);
    if (!warnings.length) console.error(`--- gateway stderr ---\n${result.stderr || '(empty)'}`);
    console.error(`  clone kept for inspection: ${homeDir}`);
  }
  return result;
}

async function cmdPreflight(args) {
  const result = await runMigrationPreflight(args, args._[1] || 'latest');
  if (args.json) console.log(JSON.stringify(result, null, 2));
  process.exit(result.ok ? 0 : 1);
}

async function cmdPromote(args) {
  const version = args._[1];
  if (!version) throw new Error('promote requires <version>');
  if (!args.yes && !args.dryRun) throw new Error('promote requires --yes (or --dry-run)');
  if (!args.dryRun) installTranscript(`promote-${version}`);
  assertBonjourDisabled();
  const target = versionDir(version);
  if (!existsSync(packageDir(version))) throw new Error(`version is not staged: ${version}. Run openclaw-update stage ${version}`);
  const oldTarget = existsSync(CURRENT_LINK) ? readlink(CURRENT_LINK) : null;
  const oldVersion = oldTarget ? basename(oldTarget) : currentVersion();
  if (!args.stepBase) console.log(`Promoting ${oldVersion ?? 'unknown'} → ${version}`);
  if (args.dryRun) { console.log(`[dry-run] would set current -> versions/${version}, restart gateway, run smoketest`); return; }

  // Cheapest possible failure: catch a startup-migration gate here, on a clone,
  // instead of after bootout — where the only exit is a 30s health timeout and an
  // auto-rollback that undoes the whole promote.
  if (!args.skipPreflight) {
    const pf = await runMigrationPreflight(args, version);
    if (!pf.ok) throw new Error(`migration preflight failed for ${version}; live gateway untouched. Fix the reported state, or re-run with --skip-preflight to override.`);
  }
  pinNodeFor(version);

  mkdirSync(OPENCLAW_DIR, { recursive: true });
  if (oldTarget) {
    // `previous` may be a symlink-to-directory; rmSync() defaults complain about
    // "Path is a directory". Use unlinkSync on symlinks, rmSync(recursive) on real dirs.
    if (existsSync(PREVIOUS_LINK)) {
      try {
        if (lstatSync(PREVIOUS_LINK).isSymbolicLink()) unlinkSync(PREVIOUS_LINK);
        else rmSync(PREVIOUS_LINK, { recursive: true, force: true });
      } catch (err) {
        throw new Error(`cannot remove ~/.openclaw/previous (${err.message})`);
      }
    }
    process.chdir(OPENCLAW_DIR);
    run('ln', ['-sfn', `versions/${oldVersion}`, 'previous']);
  }
  const cfg = resolve(OPENCLAW_DIR, 'openclaw.json');
  if (existsSync(cfg)) {
    const backupName = `openclaw.json.pre-promote-${new Date().toISOString().replace(/[:.]/g, '-')}`;
    cpSync(cfg, resolve(OPENCLAW_DIR, backupName), { force: true });
    if (args.stepBase) console.log(`[${args.stepBase}a/6]   Backing up openclaw.json → ${backupName}`);
  }

  // §13.2 — Snapshot config state into the OLD version's dir before we leave it.
  // On future rollback, this is what restores the openclaw.json that old version expects.
  if (oldTarget && existsSync(oldTarget)) {
    if (!args.stepBase) console.log(`Snapshotting ~/.openclaw config into versions/${oldVersion}/.state-snapshot/`);
    try { snapshotState(oldTarget); }
    catch (err) { console.log(`  snapshot warning: ${err.message}`); }
  }

  // §13.3 — Tag ~/clawd so rollback can show drift since the promote.
  const clawdTag = tagClawdGit(oldVersion ?? 'unknown', version);

  process.chdir(OPENCLAW_DIR);
  run('ln', ['-sfn', `versions/${version}`, 'current']);
  if (args.stepBase) console.log(`[${args.stepBase}b/6]   Swapping symlink → current → ${version}`);
  addEvent({ event: 'promote', current: version, previous: oldVersion, path: target, clawdTag });

  // External plugins hold an ABSOLUTE peer link to the openclaw runtime they were
  // installed against. The swap above makes those links stale, and the startup
  // guard rejects a stale peer link — so the gateway would refuse to come up and
  // auto-rollback would undo the promote. Relink before restart.
  const repair = spawnSync(NODE, [resolve(packageDir(version), 'dist/index.js'), 'update', 'repair', '--yes'], { encoding: 'utf8', timeout: 900000 });
  if (args.stepBase) console.log(`[${args.stepBase}b2/6]  Converging plugins → ${repair.status === 0 ? 'ok' : `exit ${repair.status} (continuing)`}`);
  else console.log(repair.status === 0 ? 'Plugins converged against the new runtime.' : `  update repair exited ${repair.status}; continuing — the post-promote smoketest is the gate.`);

  let smoketestReport = null;
  try {
    await platformRestartGateway(packageDir(version));
    if (args.stepBase) console.log(`[${args.stepBase}c/6]   Reloading launchd → kickstart ok`);
    const report = await runSmoketest({ target: 'current', mode: 'quick', installDir: packageDir(version), configDir: OPENCLAW_DIR, port: 18789, telegram: args.telegram, models: args.withModels });
    smoketestReport = report;
    if (args.stepBase) {
      const total = report.passed + report.failed;
      const failDetail = report.failed
        ? ` (${report.results.filter(r => !r.ok).map(f => `#${String(f.id).padStart(2, '0')} ${f.name}: ${f.detail}`).join(', ')})`
        : '';
      console.log(`[${args.stepBase}d/6]   Live smoke test → ${report.passed}/${total} passed${failDetail}`);
    } else {
      console.log(formatTextReport(report));
    }
    if (report.failed) throw new Error('post-promote smoketest failed');
    if (!args.stepBase) console.log(`Promote successful: ${version}`);
    const okCount = report.passed;
    const totalCount = report.passed + report.failed;
    await notify(
      `OpenClaw ${version} is live. Live smoke test: ${okCount}/${totalCount} passed. Previous version retained at ~/.openclaw/versions/${oldVersion}/. Rollback: openclaw-rollback`
    );
  } catch (err) {
    console.error(`Promote failed: ${err.message}`);
    console.error('Attempting automatic rollback...');
    let rollbackEnv = process.env;
    if (smoketestReport) {
      try {
        const tmpFile = resolve(tmpdir(), `openclaw-smoketest-${Date.now()}.json`);
        writeFileSync(tmpFile, JSON.stringify(smoketestReport, null, 2) + '\n');
        rollbackEnv = { ...process.env, OPENCLAW_SMOKETEST_RESULT_FILE: tmpFile };
      } catch {}
    }
    run(resolve(HERE, 'openclaw-rollback'), [], { stdio: 'inherit', timeout: 120000, env: rollbackEnv });
    await notify(
      `OpenClaw promote to ${version} FAILED: ${err.message.slice(0, 200)}. Auto-rolled back to ${oldVersion}. Check ~/clawd/clawd-resilience/openclaw-update/forensics/ for details.`
    );
    process.exit(1);
  }
}

function cmdRollback() {
  installTranscript('rollback');
  const r = run(resolve(HERE, 'openclaw-rollback'), [], { stdio: 'inherit', timeout: 120000 });
  process.exit(r.status ?? 0);
}

function cmdCleanup(args) {
  if (!args.yes && !args.dryRun) throw new Error('cleanup requires --yes (or --dry-run)');
  if (!args.dryRun) installTranscript('cleanup');
  const current = existsSync(CURRENT_LINK) ? basename(readlink(CURRENT_LINK)) : null;
  const previous = existsSync(PREVIOUS_LINK) ? basename(readlink(PREVIOUS_LINK)) : null;
  const protectedSet = new Set([current, previous].filter(Boolean));
  const allVersions = listVersions();
  const cleanCandidates = allVersions.filter(v => !protectedSet.has(v) && !v.includes('.broken-')).sort().reverse();
  const remove = cleanCandidates.slice(args.keep);
  if (args.includeBroken) {
    const brokenDirs = allVersions.filter(v => v.includes('.broken-'));
    remove.push(...brokenDirs);
  }
  if (!remove.length) { console.log('Nothing to clean.'); return; }
  for (const v of remove) {
    const p = versionDir(v);
    if (args.dryRun) console.log(`[dry-run] remove ${p}`);
    else { rmSync(p, { recursive: true, force: true }); console.log(`removed ${p}`); }
  }
  if (!args.dryRun) addEvent({ event: 'cleanup', removed: remove });
}

async function cmdInteractive(args) {
  const autoYes = args.yes || !process.stdin.isTTY;

  async function ask(label) {
    if (autoYes) { console.log(`${label} [auto]`); return true; }
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    return new Promise(res => {
      rl.question(`${label} [y/N] `, answer => { rl.close(); res(answer.trim().toLowerCase() === 'y'); });
    });
  }

  // [1/6] Check for updates
  process.stdout.write('[1/6] Checking for updates... ');
  const current = currentVersion();
  const latest = latestVersion();
  if (current === latest) {
    console.log(`OpenClaw is current (${current}).`);
    process.exit(0);
  }
  console.log(`${latest} available (current: ${current})`);

  // [2/6] Stage?
  if (!await ask('[2/6] Stage?')) { console.log('Aborted.'); process.exit(0); }
  const t0 = Date.now();
  cmdStage({ ...args, _: ['stage', latest] });
  console.log(`[2/6] Staged ${latest} (${Math.round((Date.now() - t0) / 1000)}s)`);

  // [3/6] Sandbox smoke test?
  if (!await ask('[3/6] Sandbox smoke test?')) {
    console.log('[3/6] Sandbox smoke test skipped.');
  } else {
    const { report } = await runSandboxTestCore({ ...args, _: ['sandbox-test', latest] }, latest);
    const passed = report.passed, total = report.passed + report.failed;
    console.log(`[3/6] Sandbox smoke test: ${passed}/${total} passed`);
    if (report.aborted) {
      console.error(`Sandbox smoke test aborted: ${report.aborted}`);
      process.exit(1);
    }
    if (report.failed) {
      console.error(`Sandbox smoke test had ${report.failed} failure(s). Not promoting.`);
      console.error(`Fix the issue or skip specific tests with --skip <ids> and re-run.`);
      process.exit(1);
    }
  }

  // [4/6] Promote?
  if (!await ask('[4/6] Promote?')) {
    console.log(`Aborted. ${latest} is staged — run: openclaw-update promote ${latest} --yes`);
    process.exit(0);
  }

  await cmdPromote({ ...args, _: ['promote', latest], yes: true, stepBase: '4' });

  console.log('[5/6] Promote successful.');
  console.log(`[6/6] Previous version retained at ~/.openclaw/versions/${current}/. Rollback: openclaw-rollback`);
}

async function cmdUninstall(args) {
  if (!args.yes && !args.dryRun) throw new Error('uninstall requires --yes (or --dry-run)');
  if (!args.dryRun) installTranscript('uninstall');

  const BREW_BIN = '/opt/homebrew/bin/openclaw';
  const STUB_FINGERPRINT = 'openclaw is managed by openclaw-update';
  const UPDATE_TOOLS = ['openclaw-update', 'openclaw-rollback', 'openclaw-smoketest'];

  function tryLstat(p) { try { return lstatSync(p); } catch { return null; } }

  // Step 1 — Verify gateway is healthy before touching anything
  console.log('Step 1 — Verifying gateway is healthy...');
  const healthR = spawnSync('curl', ['-sf', '--max-time', '5', 'http://127.0.0.1:18789/healthz'], { encoding: 'utf8', timeout: 10000 });
  if (healthR.status !== 0 || !(healthR.stdout || '').includes('"ok":true')) {
    throw new Error(
      'Gateway is not healthy; uninstalling now would leave it broken.\n' +
      '  Diagnose: openclaw-update status\n' +
      '  Repair:   openclaw-rollback'
    );
  }
  console.log('  ✓ Gateway healthy.');

  // Verify current/previous symlinks point to real version directories (if migrated)
  const currentLst = tryLstat(CURRENT_LINK);
  const isMigrated = currentLst?.isSymbolicLink() ?? false;
  if (isMigrated) {
    const currentTarget = readlink(CURRENT_LINK);
    if (!currentTarget || !existsSync(currentTarget)) {
      throw new Error(
        'The ~/.openclaw/current symlink is dangling — the target directory does not exist.\n' +
        '  Diagnose: openclaw-update status'
      );
    }
    const pkgNpm = resolve(currentTarget, 'node_modules/openclaw/package.json');
    const pkgLegacy = resolve(currentTarget, 'lib/node_modules/openclaw/package.json');
    if (!existsSync(pkgNpm) && !existsSync(pkgLegacy)) {
      throw new Error(
        `~/.openclaw/current points to ${currentTarget} but no openclaw package found there.\n` +
        '  Diagnose: openclaw-update status'
      );
    }
    const prevLst = tryLstat(PREVIOUS_LINK);
    const prevTarget = prevLst?.isSymbolicLink() ? readlink(PREVIOUS_LINK) : null;
    if (!prevTarget || !existsSync(prevTarget)) {
      console.log('  ⚠ ~/.openclaw/previous is missing or dangling — no automated rollback if uninstall encounters issues.');
    } else {
      console.log('  ✓ Symlinks healthy: current and previous both resolve.');
    }
  }

  // Step 2 — Locate the system (pre-migration) openclaw package
  console.log('Step 2 — Locating system openclaw install...');
  let systemInstallDir = BREW_INSTALL; // /opt/homebrew/lib/node_modules/openclaw on macOS
  if (process.platform !== 'darwin') {
    const npmRootR = run('npm', ['root', '-g'], { timeout: 15000 });
    if (npmRootR.status !== 0) throw new Error(`Cannot determine npm global root: ${npmRootR.stderr || npmRootR.stdout}`);
    systemInstallDir = resolve(npmRootR.stdout.trim(), 'openclaw');
  }
  const systemPkg = resolve(systemInstallDir, 'package.json');
  if (!existsSync(systemPkg)) {
    throw new Error(
      `System openclaw not found at ${systemInstallDir}.\n` +
      `  It was removed during migration (npm uninstall -g openclaw).\n` +
      `  Re-install it first, then re-run:\n` +
      `    npm install -g openclaw\n` +
      `    openclaw-update uninstall --yes`
    );
  }
  const systemEntry = resolve(systemInstallDir, 'dist/index.js');
  if (!existsSync(systemEntry)) {
    throw new Error(
      `System openclaw at ${systemInstallDir} is missing dist/index.js.\n` +
      `  The install may be corrupt. Try: npm install -g openclaw`
    );
  }
  let systemVersion = null;
  try { systemVersion = JSON.parse(readFileSync(systemPkg, 'utf8')).version; } catch {}
  console.log(`  ✓ Found system openclaw${systemVersion ? ` ${systemVersion}` : ''} at ${systemInstallDir}`);

  // Step 3 — Restore launchd plist (macOS) or systemd unit (Linux) to system openclaw path
  const versionedEntry = `${homedir()}/.openclaw/current/lib/node_modules/openclaw/dist/index.js`;
  if (process.platform === 'darwin') {
    console.log('Step 3 — Restoring launchd plist to system openclaw path...');
    if (!existsSync(GATEWAY_PLIST)) throw new Error(`Gateway plist not found at ${GATEWAY_PLIST}`);
    const plistContent = readFileSync(GATEWAY_PLIST, 'utf8');
    if (!plistContent.includes(versionedEntry)) {
      if (plistContent.includes(systemEntry)) {
        console.log('  · Plist already points at system path — no change needed.');
      } else {
        throw new Error(
          `Cannot identify the managed plist entry to restore.\n` +
          `  Expected to find: ${versionedEntry}\n` +
          `  In plist: ${GATEWAY_PLIST}\n` +
          `  The plist may have been manually edited. Inspect and restore it manually.`
        );
      }
    } else if (args.dryRun) {
      console.log(`  [dry-run] would update plist:\n    ${versionedEntry}\n    → ${systemEntry}`);
    } else {
      const TS = new Date().toISOString().replace(/[:.]/g, '-');
      const plistBackup = `${GATEWAY_PLIST}.pre-uninstall-${TS}`;
      cpSync(GATEWAY_PLIST, plistBackup, { force: true });
      console.log(`  Backed up plist to ${plistBackup}`);
      writeFileSync(GATEWAY_PLIST, plistContent.replaceAll(versionedEntry, systemEntry));
      console.log(`  ✓ Plist updated → ${systemEntry}`);
    }
  } else {
    console.log('Step 3 — Restoring systemd unit to system openclaw path...');
    const userUnitPath = resolve(homedir(), `.config/systemd/user/${GATEWAY_LABEL}.service`);
    const systemUnitPath = `/etc/systemd/system/${GATEWAY_LABEL}.service`;
    const unitPath = existsSync(userUnitPath) ? userUnitPath : existsSync(systemUnitPath) ? systemUnitPath : null;
    if (!unitPath) {
      console.log('  · No systemd unit found — skipping unit file update.');
      console.log(`    (Looked for: ${userUnitPath}  and  ${systemUnitPath})`);
    } else {
      const unitContent = readFileSync(unitPath, 'utf8');
      if (!unitContent.includes(versionedEntry)) {
        if (unitContent.includes(systemEntry)) {
          console.log('  · Systemd unit already points at system path — no change needed.');
        } else {
          console.log(`  ⚠ Could not identify managed entry in ${unitPath} — inspect and update ExecStart manually.`);
        }
      } else if (args.dryRun) {
        console.log(`  [dry-run] would update ${unitPath}:\n    ${versionedEntry}\n    → ${systemEntry}`);
      } else {
        const TS = new Date().toISOString().replace(/[:.]/g, '-');
        cpSync(unitPath, `${unitPath}.pre-uninstall-${TS}`, { force: true });
        writeFileSync(unitPath, unitContent.replaceAll(versionedEntry, systemEntry));
        const scope = unitPath.startsWith(homedir()) ? ['--user'] : [];
        spawnSync('systemctl', [...scope, 'daemon-reload'], { encoding: 'utf8', timeout: 10000 });
        console.log(`  ✓ Systemd unit updated → ${systemEntry}`);
      }
    }
  }

  // Step 4 — Remove managed stub at /opt/homebrew/bin/openclaw if still present
  console.log('Step 4 — Restoring /opt/homebrew/bin/openclaw...');
  const brewBinSt = tryLstat(BREW_BIN);
  if (brewBinSt) {
    let isStub = false;
    try { isStub = !brewBinSt.isSymbolicLink() && readFileSync(BREW_BIN, 'utf8').includes(STUB_FINGERPRINT); } catch {}
    if (isStub) {
      if (args.dryRun) {
        console.log(`  [dry-run] would remove stub and restore symlink at ${BREW_BIN}`);
      } else {
        unlinkSync(BREW_BIN);
        // npm install -g openclaw should have recreated the symlink. If the stub was
        // not overwritten by npm (edge case), recreate the symlink ourselves.
        if (!tryLstat(BREW_BIN)) {
          const mjs = resolve(systemInstallDir, 'openclaw.mjs');
          if (existsSync(mjs)) {
            symlinkSync('../lib/node_modules/openclaw/openclaw.mjs', BREW_BIN);
            console.log(`  ✓ Restored symlink at ${BREW_BIN}`);
          } else {
            console.log(`  ✓ Removed stub at ${BREW_BIN} (run: npm install -g openclaw to restore the symlink)`);
          }
        } else {
          console.log(`  ✓ Removed stub at ${BREW_BIN}`);
        }
      }
    } else {
      console.log('  · Brew binary is not the managed stub — skipping.');
    }
  } else {
    console.log('  · /opt/homebrew/bin/openclaw not present — skipping.');
  }

  // Step 5 — Remove update tools from ~/.openclaw/bin/
  console.log('Step 5 — Removing openclaw-update tools from ~/.openclaw/bin/...');
  const binDir = resolve(OPENCLAW_DIR, 'bin');
  for (const tool of UPDATE_TOOLS) {
    const p = resolve(binDir, tool);
    const st = tryLstat(p);
    if (!st) { console.log(`  · ${tool} not found — skipping.`); continue; }
    if (args.dryRun) { console.log(`  [dry-run] would remove ${p}`); continue; }
    try {
      if (st.isSymbolicLink()) unlinkSync(p);
      else rmSync(p, { recursive: true, force: true });
      console.log(`  ✓ removed ${p}`);
    } catch (err) {
      console.log(`  ⚠ could not remove ${p}: ${err.message} (non-fatal, remove manually)`);
    }
  }

  // Step 6 — Optionally remove ~/.openclaw/versions/; default is keep
  console.log('Step 6 — Managing ~/.openclaw/versions/...');
  if (args.removeVersions) {
    if (args.dryRun) {
      console.log(`  [dry-run] would remove ${VERSIONS_DIR}`);
      console.log(`  [dry-run] would remove dangling symlinks: ${CURRENT_LINK}, ${PREVIOUS_LINK}`);
      console.log(`  [dry-run] would remove ${resolve(OPENCLAW_DIR, 'bin/openclaw')} wrapper`);
    } else if (existsSync(VERSIONS_DIR)) {
      rmSync(VERSIONS_DIR, { recursive: true, force: true });
      console.log(`  ✓ Removed ${VERSIONS_DIR}`);
      // current/previous symlinks are now dangling — remove them
      for (const link of [CURRENT_LINK, PREVIOUS_LINK]) {
        if (tryLstat(link)?.isSymbolicLink()) {
          try { unlinkSync(link); console.log(`  ✓ Removed dangling symlink: ${link}`); }
          catch (err) { console.log(`  ⚠ Could not remove ${link}: ${err.message}`); }
        }
      }
      // The ~/.openclaw/bin/openclaw wrapper now points at a deleted current/ target — remove it
      const openclawWrapper = resolve(OPENCLAW_DIR, 'bin/openclaw');
      if (tryLstat(openclawWrapper)) {
        try { unlinkSync(openclawWrapper); console.log(`  ✓ Removed ${openclawWrapper}`); }
        catch (err) { console.log(`  ⚠ Could not remove ${openclawWrapper}: ${err.message} (remove manually)`); }
      }
      console.log(`  To remove ~/.openclaw/bin from PATH, edit ~/.zshrc and delete the line:`);
      console.log(`    export PATH="$HOME/.openclaw/bin:$PATH"`);
    } else {
      console.log('  · versions/ directory already gone — skipping.');
    }
  } else {
    if (existsSync(VERSIONS_DIR)) {
      console.log(`  Keeping ${VERSIONS_DIR} (default).`);
      console.log(`  To delete later:  rm -rf ${VERSIONS_DIR}`);
      const openclawWrapper = resolve(OPENCLAW_DIR, 'bin/openclaw');
      if (tryLstat(openclawWrapper)) {
        console.log(`  ⚠ ${openclawWrapper} still exists and ~/.openclaw/bin may be in your PATH.`);
        console.log(`    The 'openclaw' shell command will continue to invoke the managed version`);
        console.log(`    while the gateway now runs the system version — these may differ.`);
        console.log(`    To avoid confusion, remove the wrapper and update your PATH:`);
        console.log(`      rm ${openclawWrapper}`);
        console.log(`    Then edit ~/.zshrc (or ~/.bashrc) to remove the line:`);
        console.log(`      export PATH="$HOME/.openclaw/bin:$PATH"`);
      }
    }
  }

  if (args.dryRun) {
    console.log('\n[dry-run] No changes were made.');
    return;
  }

  // Step 7 — Restart gateway; plist now points at the system install
  console.log('Step 7 — Restarting gateway (plist now points at system openclaw)...');
  await platformRestartGateway(systemInstallDir);
  console.log('  ✓ Gateway restarted.');

  // Step 8 — Smoketest the reverted setup
  console.log('Step 8 — Verifying reverted setup...');
  const report = await runSmoketest({
    target: 'current',
    mode: 'quick',
    installDir: systemInstallDir,
    configDir: OPENCLAW_DIR,
    port: 18789,
    telegram: args.telegram,
    models: false,
    skip: args.skip,
  });
  console.log(formatTextReport(report));
  if (report.failed) throw new Error('Post-uninstall smoketest failed. Gateway may need manual attention.');

  addEvent({ event: 'uninstall', systemInstallDir, removedVersions: args.removeVersions });

  console.log('\nUninstall complete. The gateway is now running the system openclaw.');
  if (!args.removeVersions && existsSync(VERSIONS_DIR)) {
    console.log(`Staged versions remain in ${VERSIONS_DIR}.`);
    console.log(`Delete in ~30 days with:  rm -rf ${VERSIONS_DIR}`);
  }
}

async function main() {
  const args = parse(process.argv);
  const cmd = args._[0];
  if (!cmd) await cmdInteractive(args);
  else if (cmd === 'check') await cmdCheck(args);
  else if (cmd === 'status') cmdStatus(args);
  else if (cmd === 'stage') cmdStage(args);
  else if (cmd === 'sandbox-test') await cmdSandboxTest(args);
  else if (cmd === 'preflight') await cmdPreflight(args);
  else if (cmd === 'smoketest') await cmdSmoketest(args);
  else if (cmd === 'promote') await cmdPromote(args);
  else if (cmd === 'rollback') cmdRollback(args);
  else if (cmd === 'cleanup') cmdCleanup(args);
  else if (cmd === 'uninstall') await cmdUninstall(args);
  else { usage(); process.exit(64); }
}

main().catch(err => {
  console.error(`openclaw-update: ${err.message}`);
  process.exit(1);
});
